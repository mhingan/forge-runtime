# Runtime
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO
FORGE_DATABASE_URL=sqlite:///./.forge/forge.db
FORGE_WORKSPACE_ROOT=.
FORGE_MAX_PARALLEL_TASKS=4
FORGE_TASK_TIMEOUT_SECONDS=900
FORGE_MCP_ENABLED=true

# Sandboxed command execution for OpenAI/Anthropic agents (requires Docker)
FORGE_SANDBOX_NETWORK=bridge
FORGE_SANDBOX_ENABLED=true
FORGE_SANDBOX_IMAGE=forge-runtime-sandbox:internet-v1
FORGE_SANDBOX_DOCKER_BINARY=docker
FORGE_SANDBOX_CPU_LIMIT=2
FORGE_SANDBOX_MEMORY_MB=2048
FORGE_SANDBOX_PIDS_LIMIT=128
FORGE_SANDBOX_DEFAULT_TIMEOUT_SECONDS=180
FORGE_SANDBOX_MAX_TIMEOUT_SECONDS=600
FORGE_SANDBOX_OUTPUT_CHARS=24000
FORGE_SANDBOX_MAX_SNAPSHOT_FILES=5000
FORGE_SANDBOX_MAX_SNAPSHOT_MB=512
FORGE_DEFAULT_PROVIDER=mock

# AgentForge registry
FORGE_AGENTFORGE_SOURCE=auto
FORGE_AGENTFORGE_REPOSITORY=https://github.com/mhingan/agent-forge
FORGE_AGENTFORGE_REF=main
FORGE_AGENTFORGE_LOCAL_PATH=

# Hosted model providers (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Local HTTP API
FORGE_API_HOST=127.0.0.1
FORGE_API_PORT=8787
FORGE_API_TOKEN=
